# Dockerfile for act testing with ARM64 support
# Combines Erlang/OTP and Node.js for GitHub Actions compatibility
# Keep version in sync with main Dockerfile (erlang:27-alpine)
FROM erlang:27-alpine

# Install Node.js for GitHub Actions checkout@v4 compatibility
RUN apk update && \
    apk add --no-cache \
    curl \
    nodejs \
    npm \
    git \
    ca-certificates

# Verify installations
RUN erl -version && \
    node --version && \
    npm --version && \
    git --version

WORKDIR /workspace
ENV ERL_AFLAGS=-noshell
