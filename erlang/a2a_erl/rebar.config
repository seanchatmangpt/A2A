%% -*- mode: erlang; -*-
%% A2A Erlang/OTP Implementation - rebar3 configuration
%% Requires OTP 28 or later

{minimum_otp_vsn, "28"}.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_export_vars,
    warn_unused_import,
    {i, "include"}
]}.

{deps, [
    %% Cowboy web server for HTTP/SSE
    {cowboy, "2.12.0"}
]}.

%% Shell configuration for development
{shell, [
    {apps, [a2a_erl]},
    {config, "config/sys.config"}
]}.

%% Release configuration
{relx, [
    {release, {a2a_erl, "0.1.0"}, [
        a2a_erl,
        sasl,
        inets,
        crypto
    ]},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"}
]}.

{profiles, [
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true}
        ]}
    ]},
    {test, [
        {deps, [
            {meck, "0.9.2"},
            {proper, "1.4.0"}
        ]},
        {erl_opts, [nowarn_export_all]}
    ]}
]}.

%% Dialyzer type checking
{dialyzer, [
    {warnings, [
        unmatched_returns,
        error_handling,
        unknown
    ]},
    {plt_apps, all_deps},
    {plt_extra_apps, [inets, crypto]}
]}.

%% EDoc documentation
{edoc_opts, [
    {preprocess, true},
    {includes, ["include"]}
]}.

%% Code coverage
{cover_enabled, true}.
{cover_opts, [verbose]}.
