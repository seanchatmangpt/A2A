%% -*- mode: erlang; -*-
%% A2A Erlang/OTP Implementation - rebar3 configuration
%% Requires OTP 27 or later

%% HotCI Integration - Template: required
{minimum_otp_vsn, "27"}.

{erl_opts, [
    debug_info
]}.

{deps, [
    %% Cowboy web server for HTTP/SSE
    {cowboy, "2.12.0"},
    %% JSON library for encoding/decoding
    {jiffy, "1.1.1"}
]}.

%% HotCI: To generate appups automatically (currently disabled)
{plugins, []}.
{project_plugins, []}.

%% HotCI: Export common test results as XML (not available, using built-in)
{ct_opts, []}.

%% Shell configuration for development
{shell, [
    {apps, [a2a_erl]},
    {config, "config/sys.config"}
]}.

%% Release configuration
%% HotCI: Updated relx config with include_src, debug_info, and include_erts for Docker
{relx, [
    {release, {a2a_erl, "0.1.0"}, [
        a2a_erl,
        sasl,
        inets,
        crypto,
        cowboy,
        jiffy,
        ranch,
        cowlib,
        pc
    ]},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"},
    {include_src, false},
    {debug_info, keep}
]}.

{profiles, [
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true},
            {sys_config, "config/sys.config"},
            {vm_args, "config/vm.args.prod"}
        ]}
    ]},
    {test, [
        {deps, [
            {meck, "0.9.2"},
            {proper, "1.4.0"}
        ]},
        {erl_opts, [nowarn_export_all]}
    ]},

    %% HotCI profile for upgrade/downgrade testing
    {hotci, [
        {erl_opts, [nowarn_export_all, debug_info]},
        {deps, [
            {proper, "1.4.0"}
        ]}
    ]}
]}.

%% Dialyzer type checking
{dialyzer, [
    {warnings, [
        unmatched_returns,
        error_handling,
        unknown
    ]},
    {plt_apps, all_deps},
    {plt_extra_apps, [inets, crypto]}
]}.

%% EDoc documentation
{edoc_opts, [
    {preprocess, true},
    {includes, ["include"]}
]}.

%% Code coverage
{cover_enabled, true}.
{cover_opts, [verbose]}.

%% HotCI: Tell xref what checks to perform
{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.
