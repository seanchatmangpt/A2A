%% -*- mode: erlang; -*-
%% A2A Erlang/OTP Implementation - rebar3 configuration
%% Requires OTP 28 or later

%% HotCI Integration - Template: required
{minimum_otp_vsn, "28"}.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_export_vars,
    warn_unused_import,
    {i, "include"}
]}.

{deps, [
    %% Cowboy web server for HTTP/SSE
    {cowboy, "2.12.0"},

    %% HotCI: cth_surefire for exporting test results as XML
    {cth_surefire, "1.2.0"}
]}.

%% HotCI: To generate appups automatically thanks to the appup_plugin
{plugins, [
    {rebar3_appup_plugin,
        {git, "https://github.com/lrascao/rebar3_appup_plugin", {branch, "develop"}}}
]}.
{project_plugins, [erlfmt]}.
{provider_hooks, [
    {pre, [{tar, {appup, tar}}]},
    {post, [
        {compile, {appup, compile}},
        {clean, {appup, clean}}
    ]}
]}.

%% HotCI: Export common test results as XML
{ct_opts, [{ct_hooks, [cth_surefire]}]}.

%% Shell configuration for development
{shell, [
    {apps, [a2a_erl]},
    {config, "config/sys.config"}
]}.

%% Release configuration
%% HotCI: Updated relx config with include_src, debug_info, and include_erts for Docker
{relx, [
    {release, {a2a_erl, "0.1.0"}, [
        a2a_erl,
        sasl,
        inets,
        crypto
    ]},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"},
    {include_src, false},
    {debug_info, keep}
]}.

{profiles, [
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true}
        ]}
    ]},
    {test, [
        {deps, [
            {meck, "0.9.2"},
            {proper, "1.4.0"}
        ]},
        {erl_opts, [nowarn_export_all]}
    ]},

    %% HotCI profile for upgrade/downgrade testing
    {hotci, [
        {erl_opts, [nowarn_export_all, debug_info]},
        {deps, [
            {cth_surefire, "1.2.0"}
        ]}
    ]}
]}.

%% Dialyzer type checking
{dialyzer, [
    {warnings, [
        unmatched_returns,
        error_handling,
        unknown
    ]},
    {plt_apps, all_deps},
    {plt_extra_apps, [inets, crypto]}
]}.

%% EDoc documentation
{edoc_opts, [
    {preprocess, true},
    {includes, ["include"]}
]}.

%% Code coverage
{cover_enabled, true}.
{cover_opts, [verbose]}.

%% HotCI: Tell xref what checks to perform
{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.
