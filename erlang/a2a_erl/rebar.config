%% -*- mode: erlang; -*-
%% A2A Erlang/OTP Implementation - rebar3 configuration
%% Requires OTP 27 or later

%% HotCI Integration - Template: required
{minimum_otp_vsn, "27"}.

{erl_opts, [
    debug_info,
    {src_dirs, ["src", "tests", "src_hotci"]}
]}.

%% BeamAI umbrella app directories
{project_app_dirs, ["apps/*", "src"]}.

{deps, [
    %% Cowboy web server for HTTP/SSE
    {cowboy, "2.12.0"},
    %% JSON library for encoding/decoding
    {jiffy, "1.1.1"},
    %% Petri net workflow engine for YAWL patterns
    {gen_pnet, "0.1.7"},
    %% --- BeamAI dependencies ---
    %% JSON library (alternative to jiffy, used by beamai modules)
    {jsx, "3.1.0"},
    %% HTTP client for LLM API calls
    {hackney, "1.20.1"},
    %% HTTP/2 client for MCP and streaming
    {gun, "2.1.0"},
    %% UUID generation for request/session IDs
    {uuid, "2.0.6", {pkg, uuid_erl}},
    %% SQLite for persistent memory backend
    {esqlite, "0.8.8"},
    %% Worker pool for connection management
    {poolboy, "1.5.2"}
]}.

%% HotCI: To generate appups automatically (currently disabled)
{plugins, []}.
{project_plugins, []}.

%% HotCI: Export common test results as XML using cth_surefire
{ct_opts, [{ct_hooks, [cth_surefire]}]}.

%% Shell configuration for development
{shell, [
    {apps, [a2a_erl]},
    {config, "config/sys.config"}
]}.

%% Release configuration
%% HotCI: Updated relx config with include_src, debug_info, and include_erts for Docker
{relx, [
    {release, {a2a_erl, "0.1.0"}, [
        a2a_erl,
        sasl,
        inets,
        crypto,
        cowboy,
        jiffy,
        ranch,
        cowlib,
        pc,
        %% BeamAI framework applications
        beamai_core,
        beamai_tools,
        beamai_memory,
        beamai_llm,
        beamai_agent,
        beamai_mcp,
        beamai_a2a,
        beamai_rag,
        beamai_deepagent
    ]},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"},
    {include_src, false},
    {debug_info, keep}
]}.

{profiles, [
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true},
            {sys_config, "config/sys.config"},
            {vm_args, "config/vm.args.prod"}
        ]}
    ]},
    {test, [
        {deps, [
            {meck, "0.9.2"},
            {proper, "1.4.0"}
        ]},
        {erl_opts, [nowarn_export_all]}
    ]},

    %% HotCI profile for upgrade/downgrade testing
    {hotci, [
        {erl_opts, [nowarn_export_all, debug_info]},
        {deps, [
            {proper, "1.4.0"}
        ]}
    ]}
]}.

%% Dialyzer type checking
{dialyzer, [
    {warnings, [
        unmatched_returns,
        error_handling,
        unknown
    ]},
    {plt_apps, all_deps},
    {plt_extra_apps, [inets, crypto]}
]}.

%% EDoc documentation
{edoc_opts, [
    {preprocess, true},
    {includes, ["include"]}
]}.

%% Code coverage
{cover_enabled, true}.
{cover_opts, [verbose]}.

%% HotCI: Tell xref what checks to perform
{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

%%====================================================================
%% XES Logging Configuration
%%====================================================================
%%
%% XES (eXtensible Event Stream) logging for YAWL workflow execution.
%% Add these to your sys.config or application environment:
%%
%% {a2a_erl, [
%%     %% Enable/disable XES logging globally
%%     {xes_enabled, true},
%%
%%     %% XES log level: trace | debug | info | warn | error | none
%%     {xes_log_level, info},
%%
%%     %% Output mode: file | console | both | ets | memory
%%     {xes_output_mode, both},
%%
%%     %% Log file path (relative to application root or absolute)
%%     {xes_file_path, <<"logs/yawl_workflow.xes">>},
%%
%%     %% Buffer size before automatic flush (number of events)
%%     {xes_buffer_size, 100},
%%
%%     %% Flush interval in milliseconds (0 to disable periodic flush)
%%     {xes_flush_interval, 5000},
%%
%%     %% Include data attributes in events
%%     {xes_include_data_attrs, true},
%%
%%     %% Include organizational attributes in events
%%     {xes_include_org_attrs, true},
%%
%%     %% Include cost attributes in events
%%     {xes_include_cost_attrs, false}
%% ]}.
