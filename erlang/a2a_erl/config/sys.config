[
  {a2a_erl, [
    %% HTTP Server Configuration
    {port, 8080},
    {host, "localhost"},
    {scheme, "http"}
  ]},

  {kernel, [
    %% Logger configuration
    {logger_level, info},
    {logger, [
      {handler, default, logger_std_h,
        #{level => info,
          formatter => {logger_formatter, #{
            single_line => true,
            template => [time, " ", level, " ", msg, "\n"]
          }}
        }
      }
    ]}
  ]},

  {sasl, [
    {sasl_error_logger, false}
  ]},

  %% --- BeamAI Framework Configuration ---
  {beamai_core, [
    {default_llm, anthropic},
    {providers, [
      {anthropic, [{model, <<"claude-sonnet-4-20250514">>}]},
      {openai, [{model, <<"gpt-4">>}]}
    ]}
  ]},

  {beamai_memory, [
    {backend, ets},
    {sqlite_path, "data/beamai_memory.db"}
  ]},

  {beamai_a2a, [
    {port, 8080},
    {enable_auth, true},
    {rate_limit, 100}
  ]}
].
