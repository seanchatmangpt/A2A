[
  {a2a_erl, [
    %% HTTP Server Configuration
    {port, 8080},
    {host, "localhost"},
    {scheme, "http"}
  ]},

  {kernel, [
    %% Logger configuration
    {logger_level, info},
    {logger, [
      {handler, default, logger_std_h,
        #{level => info,
          formatter => {logger_formatter, #{
            single_line => true,
            template => [time, " ", level, " ", msg, "\n"]
          }}
        }
      }
    ]}
  ]},

  {sasl, [
    {sasl_error_logger, false}
  ]}
].
