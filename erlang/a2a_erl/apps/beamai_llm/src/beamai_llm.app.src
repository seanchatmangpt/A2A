{application, beamai_llm, [
    {description, "BeamAI LLM - Chat completion, output parsing, and multi-provider LLM support"},
    {vsn, "0.1.0"},
    {registered, [beamai_llm_sup, beamai_chat_completion]},
    {mod, {beamai_llm_app, []}},
    {applications, [
        kernel,
        stdlib,
        hackney,
        jsx,
        beamai_core
    ]},
    {env, [
        {default_provider, anthropic},
        {default_temperature, 0.7},
        {default_max_tokens, 4096},
        {retry_max_attempts, 3},
        {retry_base_delay_ms, 1000},
        {stream_timeout_ms, 60000}
    ]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, []}
]}.
