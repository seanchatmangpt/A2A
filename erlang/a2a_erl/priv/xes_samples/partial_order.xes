<?xml version="1.0" encoding="UTF-8"?>
<log xmlns="http://www.xes-standard.org/" xes.version="1.0">
  <extension name="PartialOrder" prefix="po" uri="http://www.xes-standard.org/po.xesext"/>
  <extension name="Time" prefix="time" uri="http://www.xes-standard.org/time.xesext"/>
  <extension name="Concept" prefix="concept" uri="http://www.xes-standard.org/concept.xesext"/>
  
  <trace>
    <string key="concept:name" value="po-trace-1"/>
    <string key="po:format" value="partial-order"/>
    
    <!-- Define partial order relations -->
    <list key="po:relations">
      <string key="e1->e2" value="e1-precedes-e2"/>
      <string key="e1->e3" value="e1-precedes-e3"/>
      <string key="e2->e4" value="e2-precedes-e4"/>
      <string key="e3->e4" value="e3-precedes-e4"/>
      <string key="e2||e3" value="e2-concurrent-e3"/>
    </list>
    
    <event>
      <string key="concept:name" value="A"/>
      <string key="po:id" value="e1"/>
      <date key="time:timestamp" value="2025-01-01T10:00:00.000Z"/>
    </event>
    <event>
      <string key="concept:name" value="B"/>
      <string key="po:id" value="e2"/>
      <date key="time:timestamp" value="2025-01-01T10:02:00.000Z"/>
    </event>
    <event>
      <string key="concept:name" value="C"/>
      <string key="po:id" value="e3"/>
      <date key="time:timestamp" value="2025-01-01T10:02:00.000Z"/>
    </event>
    <event>
      <string key="concept:name" value="D"/>
      <string key="po:id" value="e4"/>
      <date key="time:timestamp" value="2025-01-01T10:05:00.000Z"/>
    </event>
  </trace>
</log>
