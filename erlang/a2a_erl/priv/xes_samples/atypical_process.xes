<?xml version="1.0" encoding="UTF-8"?>
<log xes.version="1.0" xmlns="http://www.xes-standard.org/"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://www.xes-standard.org/ xes.xsd"
     id="atypical_process_log">
  <extension name="Concept" prefix="concept" uri="http://www.xes-standard.org/concept.xesext"/>
  <extension name="Time" prefix="time" uri="http://www.xes-standard.org/time.xesext"/>
  <extension name="Organizational" prefix="org" uri="http://www.xes-standard.org/org.xesext"/>
  <extension name="Lifecycle" prefix="lifecycle" uri="http://www.xes-standard.org/lifecycle.xesext"/>

  <global scope="trace">
    <string key="concept:name" value="Atypical Order Process"/>
  </global>
  <global scope="event">
    <string key="concept:name" value=""/>
    <date key="time:timestamp" value="1970-01-01T00:00:00.000+00:00"/>
    <string key="lifecycle:transition" value="complete"/>
  </global>

  <classifier name="Activity" keys="concept:name"/>

  <!-- Trace 1: Exception handling path -->
  <trace>
    <string key="concept:name" value="trace_exception_001"/>
    <event>
      <string key="concept:name" value="order_created"/>
      <date key="time:timestamp" value="2024-02-01T10:00:00.000Z"/>
      <string key="lifecycle:transition" value="start"/>
    </event>
    <event>
      <string key="concept:name" value="order_created"/>
      <date key="time:timestamp" value="2024-02-01T10:00:05.000Z"/>
      <string key="lifecycle:transition" value="complete"/>
    </event>
    <event>
      <string key="concept:name" value="rare_exception_handler"/>
      <date key="time:timestamp" value="2024-02-01T10:00:10.000Z"/>
      <string key="lifecycle:transition" value="start"/>
    </event>
    <event>
      <string key="concept:name" value="rare_exception_handler"/>
      <date key="time:timestamp" value="2024-02-01T10:00:15.000Z"/>
      <string key="lifecycle:transition" value="complete"/>
    </event>
    <event>
      <string key="concept:name" value="manual_review_required"/>
      <date key="time:timestamp" value="2024-02-01T10:00:20.000Z"/>
      <string key="lifecycle:transition" value="start"/>
    </event>
    <event>
      <string key="concept:name" value="manual_review_required"/>
      <date key="time:timestamp" value="2024-02-01T10:05:00.000Z"/>
      <string key="lifecycle:transition" value="complete"/>
    </event>
    <event>
      <string key="concept:name" value="payment_processed"/>
      <date key="time:timestamp" value="2024-02-01T10:05:10.000Z"/>
      <string key="lifecycle:transition" value="start"/>
    </event>
    <event>
      <string key="concept:name" value="payment_processed"/>
      <date key="time:timestamp" value="2024-02-01T10:05:20.000Z"/>
      <string key="lifecycle:transition" value="complete"/>
    </event>
  </trace>

  <!-- Trace 2: Reverse order (B before A) -->
  <trace>
    <string key="concept:name" value="trace_reverse_001"/>
    <event>
      <string key="concept:name" value="payment_processed"/>
      <date key="time:timestamp" value="2024-02-02T14:00:00.000Z"/>
      <string key="lifecycle:transition" value="start"/>
    </event>
    <event>
      <string key="concept:name" value="payment_processed"/>
      <date key="time:timestamp" value="2024-02-02T14:00:10.000Z"/>
      <string key="lifecycle:transition" value="complete"/>
    </event>
    <event>
      <string key="concept:name" value="order_created"/>
      <date key="time:timestamp" value="2024-02-02T14:00:15.000Z"/>
      <string key="lifecycle:transition" value="start"/>
    </event>
    <event>
      <string key="concept:name" value="order_created"/>
      <date key="time:timestamp" value="2024-02-02T14:00:20.000Z"/>
      <string key="lifecycle:transition" value="complete"/>
    </event>
    <event>
      <string key="concept:name" value="order_shipped"/>
      <date key="time:timestamp" value="2024-02-02T14:00:25.000Z"/>
      <string key="lifecycle:transition" value="start"/>
    </event>
    <event>
      <string key="concept:name" value="order_shipped"/>
      <date key="time:timestamp" value="2024-02-02T14:00:40.000Z"/>
      <string key="lifecycle:transition" value="complete"/>
    </event>
  </trace>

  <!-- Trace 3: Optional activity appears -->
  <trace>
    <string key="concept:name" value="trace_optional_001"/>
    <event>
      <string key="concept:name" value="order_created"/>
      <date key="time:timestamp" value="2024-02-03T09:00:00.000Z"/>
      <string key="lifecycle:transition" value="start"/>
    </event>
    <event>
      <string key="concept:name" value="order_created"/>
      <date key="time:timestamp" value="2024-02-03T09:00:05.000Z"/>
      <string key="lifecycle:transition" value="complete"/>
    </event>
    <event>
      <string key="concept:name" value="optional_verification_step"/>
      <date key="time:timestamp" value="2024-02-03T09:00:10.000Z"/>
      <string key="lifecycle:transition" value="start"/>
    </event>
    <event>
      <string key="concept:name" value="optional_verification_step"/>
      <date key="time:timestamp" value="2024-02-03T09:00:15.000Z"/>
      <string key="lifecycle:transition" value="complete"/>
    </event>
    <event>
      <string key="concept:name" value="payment_processed"/>
      <date key="time:timestamp" value="2024-02-03T09:00:20.000Z"/>
      <string key="lifecycle:transition" value="start"/>
    </event>
    <event>
      <string key="concept:name" value="payment_processed"/>
      <date key="time:timestamp" value="2024-02-03T09:00:30.000Z"/>
      <string key="lifecycle:transition" value="complete"/>
    </event>
    <event>
      <string key="concept:name" value="nonexistent_activity"/>
      <date key="time:timestamp" value="2024-02-03T09:00:35.000Z"/>
      <string key="lifecycle:transition" value="start"/>
    </event>
    <event>
      <string key="concept:name" value="nonexistent_activity"/>
      <date key="time:timestamp" value="2024-02-03T09:00:40.000Z"/>
      <string key="lifecycle:transition" value="complete"/>
    </event>
    <event>
      <string key="concept:name" value="order_completed"/>
      <date key="time:timestamp" value="2024-02-03T09:00:45.000Z"/>
      <string key="lifecycle:transition" value="start"/>
    </event>
    <event>
      <string key="concept:name" value="order_completed"/>
      <date key="time:timestamp" value="2024-02-03T09:00:50.000Z"/>
      <string key="lifecycle:transition" value="complete"/>
    </event>
  </trace>

  <!-- Trace 4: Loop structure with repetition -->
  <trace>
    <string key="concept:name" value="trace_loop_001"/>
    <event>
      <string key="concept:name" value="order_created"/>
      <date key="time:timestamp" value="2024-02-04T11:00:00.000Z"/>
      <string key="lifecycle:transition" value="start"/>
    </event>
    <event>
      <string key="concept:name" value="order_created"/>
      <date key="time:timestamp" value="2024-02-04T11:00:05.000Z"/>
      <string key="lifecycle:transition" value="complete"/>
    </event>
    <event>
      <string key="concept:name" value="payment_rejected"/>
      <date key="time:timestamp" value="2024-02-04T11:00:10.000Z"/>
      <string key="lifecycle:transition" value="start"/>
    </event>
    <event>
      <string key="concept:name" value="payment_rejected"/>
      <date key="time:timestamp" value="2024-02-04T11:00:15.000Z"/>
      <string key="lifecycle:transition" value="complete"/>
    </event>
    <event>
      <string key="concept:name" value="payment_rejected"/>
      <date key="time:timestamp" value="2024-02-04T11:00:20.000Z"/>
      <string key="lifecycle:transition" value="start"/>
    </event>
    <event>
      <string key="concept:name" value="payment_rejected"/>
      <date key="time:timestamp" value="2024-02-04T11:00:25.000Z"/>
      <string key="lifecycle:transition" value="complete"/>
    </event>
    <event>
      <string key="concept:name" value="payment_processed"/>
      <date key="time:timestamp" value="2024-02-04T11:00:30.000Z"/>
      <string key="lifecycle:transition" value="start"/>
    </event>
    <event>
      <string key="concept:name" value="payment_processed"/>
      <date key="time:timestamp" value="2024-02-04T11:00:40.000Z"/>
      <string key="lifecycle:transition" value="complete"/>
    </event>
    <event>
      <string key="concept:name" value="order_completed"/>
      <date key="time:timestamp" value="2024-02-04T11:00:45.000Z"/>
      <string key="lifecycle:transition" value="start"/>
    </event>
    <event>
      <string key="concept:name" value="order_completed"/>
      <date key="time:timestamp" value="2024-02-04T11:00:50.000Z"/>
      <string key="lifecycle:transition" value="complete"/>
    </event>
  </trace>
</log>
