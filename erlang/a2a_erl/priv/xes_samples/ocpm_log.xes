<?xml version="1.0" encoding="UTF-8"?>
<log xmlns="http://www.xes-standard.org/" xes.version="1.0" xes.features="nested-attributes">
  <extension name="OCEL" prefix="ocel" uri="http://www.xes-standard.org/ocel.xesext"/>
  <extension name="ObjectCentric" prefix="oc" uri="http://www.xes-standard.org/object-centric.xesext"/>
  <extension name="Time" prefix="time" uri="http://www.xes-standard.org/time.xesext"/>
  
  <!-- Object types -->
  <list key="ocel:object-types">
    <string value="order"/>
    <string value="item"/>
    <string value="payment"/>
  </list>
  
  <!-- Global event attributes -->
  <global scope="event">
    <string key="concept:name" value="activity"/>
    <date key="time:timestamp" value="timestamp"/>
    <list key="ocel:objects" value="object_refs"/>
  </global>
  
  <!-- Object definitions -->
  <object key="order-001">
    <string key="ocel:type" value="order"/>
    <string key="ocel:ov-map" value="{&quot;status&quot;:&quot;confirmed&quot;}"/>
  </object>
  <object key="item-001">
    <string key="ocel:type" value="item"/>
    <string key="ocel:ov-map" value="{&quot;product&quot;:&quot;widget&quot;}"/>
  </object>
  <object key="payment-001">
    <string key="ocel:type" value="payment"/>
    <string key="ocel:ov-map" value="{&quot;amount&quot;:99.99}"/>
  </object>
  
  <!-- Events with multiple objects -->
  <trace>
    <string key="concept:name" value="ocpm-trace-1"/>
    <event>
      <string key="concept:name" value="Order Created"/>
      <date key="time:timestamp" value="2025-01-01T10:00:00.000Z"/>
      <list key="ocel:objects">
        <string value="order-001"/>
        <string value="item-001"/>
      </list>
    </event>
    <event>
      <string key="concept:name" value="Payment Received"/>
      <date key="time:timestamp" value="2025-01-01T10:05:00.000Z"/>
      <list key="ocel:objects">
        <string value="order-001"/>
        <string value="payment-001"/>
      </list>
    </event>
    <event>
      <string key="concept:name" value="Order Shipped"/>
      <date key="time:timestamp" value="2025-01-01T10:10:00.000Z"/>
      <list key="ocel:objects">
        <string value="order-001"/>
        <string value="item-001"/>
      </list>
    </event>
  </trace>
</log>
