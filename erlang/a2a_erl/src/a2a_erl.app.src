{application, a2a_erl,
 [{description, "A2A Agent-to-Agent Protocol Implementation in Erlang/OTP"},
  {vsn, "0.3.0"},
  {registered, [
      a2a_task_store,
      a2a_agent_card,
      a2a_task_sup,
      yawl_orchestrator,
      yawl_test_runner,
      yawl_persistence,
      yawl_service_registry,
      yawl_resource_manager,
      yawl_human_task,
      yawl_workitem_processor,
      yawl_workflow_instance_sup,
      yawl_rest_resource_handler,
      yawl_rest_task_handler,
      yawl_a2a_bridge,
      yawl_a2a_events,
      yawl_a2a_resource_integration,
      yawl_error_recovery,
      yawl_metrics,
      yawl_workflow_templates,
      yawl_workflow_definition_storage,
      %% Claude Headless & Human-in-the-Loop
      yawl_claude_headless,
      yawl_human_in_loop,
      yawl_sse_hitl
  ]},
  {mod, {a2a_erl_app, []}},
  {applications, [
      kernel,
      stdlib,
      crypto,
      inets,
      cowboy,
      gen_pnet,
      mnesia
  ]},
  {env, [
      {port, 8080},
      {host, "localhost"},
      {scheme, "http"}
  ]},
  {modules, [
      a2a_erl_app,
      a2a_erl_sup,
      a2a_task_sup,
      a2a_task_statem,
      a2a_task_store,
      a2a_agent_card,
      a2a_http_handler,
      a2a_sse_handler,
      a2a_push_notifier,
      a2a_json,
      a2a_echo_handler,
      a2a_handler,
      a2a_health_handler,
      a2a_metrics,
      %% YAWL Workflow Pattern Modules
      yawl_patterns,
      yawl_orchestrator,
      yawl_business_scenarios,
      yawl_test_runner,
      %% YAWL Execution Engine
      yawl_workflow_instance,
      yawl_workflow_instance_sup,
      yawl_workitem_processor,
      %% YAWL Persistence
      yawl_persistence,
      %% YAWL XML & XES
      yawl_xml_parser,
      yawl_xes_logger,
      yawl_xes_adapter,
      yawl_xes_formatter,
      yawl_workflow_xes,
      yawl_object_centric_xes,
      %% YAWL Resource Management
      yawl_resource_manager,
      yawl_mock_resource_manager,
      yawl_human_task,
      yawl_service_registry,
      %% YAWL-A2A Integration
      yawl_a2a_bridge,
      yawl_a2a_events,
      yawl_a2a_resource_integration,
      yawl_error_recovery,
      yawl_event_bridge,
      %% YAWL REST API
      yawl_rest,
      yawl_rest_handler,
      yawl_rest_pattern_handler,
      yawl_rest_template_handler,
      yawl_rest_definition_handler,
      yawl_rest_resource_handler,
      yawl_rest_task_handler,
      yawl_rest_workitem_handler,
      yawl_rest_service_handler,
      yawl_rest_metrics_handler,
      yawl_rest_cpn_handler,
      yawl_rest_hitl_handler,
      yawl_rest_llm_handler,
      yawl_rest_ocpm_handler,
      yawl_rest_reachability_handler,
      yawl_rest_xes_handler,
      yawl_health_handler,
      yawl_metrics,
      %% YAWL Validation & Serialization
      yawl_validation_schema,
      yawl_request_validator,
      yawl_response_serializer,
      yawl_json_export,
      %% YAWL Analysis
      yawl_concurrency_analyzer,
      yawl_cpn,
      yawl_reachability,
      yawl_partial_order,
      yawl_post_dominance,
      yawl_ocpm,
      yawl_model_comparison,
      yawl_simulation,
      yawl_llm_validator,
      %% YAWL Error Handling & Auth
      yawl_error_codes,
      yawl_error_response,
      yawl_auth_middleware,
      yawl_retry,
      yawl_shutdown,
      yawl_timeout,
      yawl_sse,
      %% YAWL Templates and Definitions
      yawl_workflow_templates,
      yawl_workflow_definition_storage,
      %% Claude Headless & Human-in-the-Loop
      yawl_claude_headless,
      yawl_human_in_loop,
      yawl_sse_hitl
  ]},
  {licenses, ["Apache-2.0"]},
  {links, [
      {"GitHub", "https://github.com/a2aproject/A2A"}
  ]}
 ]}.
