# act configuration for A2A Erlang project
# Optimized for ARM64 (Apple Silicon) with amd64 emulation

# Set container architecture for Apple Silicon/M1/M2/M3
--container-architecture linux/amd64

# Platform mappings - use official Erlang images
-P ubuntu-latest=erlang:28
-P ubuntu-22.04=erlang:28
-P ubuntu-20.04=erlang:28
-P erlang:28=erlang:28
-P erlang:27=erlang:27
-P erlang:26=erlang:26

# Bind working directory for better performance
-b

# Use cache for faster runs
--action-cache-path /Users/sac/.cache/act

# Set default actor
-a "act-runner"

# Don't skip checkout
--no-skip-checkout

# Use local images only to avoid Docker Hub auth issues
-p=false

# Use host network for better connectivity
--network host

# Set secret for GitHub token
-s GITHUB_TOKEN=act-test-token

# Additional secrets for testing
-s CUSTOM_SECRET=test-custom-secret-value
-s SECRET_FOR_TESTS=another-secret-value
