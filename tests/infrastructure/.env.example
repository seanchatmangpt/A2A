# Infrastructure Test Configuration
# Copy this file to .env and fill in your values

# Required: GCP Project ID
GCP_PROJECT_ID=your-project-id

# Optional: GCP Region (defaults to us-central1)
GCP_REGION=us-central1

# Optional: GKE Cluster Name (defaults to a2a-gke)
GKE_CLUSTER_NAME=a2a-gke

# Optional: VPC Network Name (defaults to a2a-vpc)
VPC_NETWORK_NAME=a2a-vpc

# Optional: Run integration tests (defaults to false)
RUN_INTEGRATION_TESTS=false

# Optional: Path to GCP service account key
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
