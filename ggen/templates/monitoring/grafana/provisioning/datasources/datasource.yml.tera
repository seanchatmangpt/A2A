---
description: "Grafana datasource provisioning configuration"
output_dir: "monitoring/grafana/provisioning/datasources"
file_extension: ".yml"
variables:
  app_name: "{{ module.name }}"
  namespace: "{{ namespace | default('default') }}"
  prometheus_url: "{{ prometheus_url | default('http://prometheus:9090') }}"
  prometheus_name: "{{ prometheus_name | default('Prometheus') }}"
---
{%- comment -%}
Grafana datasource provisioning configuration for Prometheus
{%- endcomment -%}

apiVersion: 1

datasources:
  - name: '{{ prometheus_name }}'
    type: prometheus
    access: proxy
    orgId: 1
    url: '{{ prometheus_url }}'
    basicAuth: false
    isDefault: true
    version: 1
    editable: false
    jsonData:
      httpMethod: POST
      queryTimeout: 60s
      timeInterval: 15s
  - name: 'Loki'
    type: loki
    access: proxy
    orgId: 1
    url: 'http://loki:3100'
    basicAuth: false
    isDefault: false
    version: 1
    editable: true
    jsonData:
      maxLines: 1000
  - name: 'Jaeger'
    type jaeger
    access: proxy
    orgId: 1
    url: 'http://jaeger:16686'
    basicAuth: false
    isDefault: false
    version: 1
    editable: true
    jsonData:
      tracesDatasource: '{{ prometheus_name }}'
      spansDatasource: '{{ prometheus_name }}'
  - name: 'Graphite'
    type: graphite
    access: proxy
    orgId: 1
    url: 'http://graphite:80'
    basicAuth: false
    isDefault: false
    version: 1
    editable: true
    jsonData:
      graphiteVersion: '1.1'
    secureJsonData:
      password: ''
    jsonData:
      httpMethod: 'POST'
  - name: 'Elasticsearch'
    type: elasticsearch
    access: proxy
    orgId: 1
    url: 'http://elasticsearch:9200'
    basicAuth: false
    isDefault: false
    version: 1
    editable: true
    jsonData:
      esVersion: '7.0'
      timeField: '@timestamp'
      interval: '1s'
    secureJsonData:
      password: ''
    jsonData:
      httpMethod: 'POST'
      logMessageField: 'message'
      maxLines: 1000