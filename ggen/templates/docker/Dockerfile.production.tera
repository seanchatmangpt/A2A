---
description: "Production-ready Docker multi-stage build file with security best practices"
output_dir: "Dockerfile"
file_extension: ""
variables:
  base_image: "erlang:27-alpine"
  app_name: "{{ module.name }}"
  app_port: "{{ port | default(8080) }}"
  hotci_enabled: "{{ module.hotci_enabled | default(false) }}"
  health_check_path: "/health"
  health_check_interval: "30s"
  health_check_timeout: "5s"
  health_check_start_period: "10s"
  health_check_retries: 3
  app_user: "appuser"
  app_group: "appuser"
  app_uid: 1001
  app_gid: 1001
---
{%- comment -%}
Production Dockerfile with multi-stage build, security hardening, and best practices
{%- endcomment -%}

# Stage 1: Builder stage
FROM {{ base_image }} AS builder

# Install build dependencies
RUN apk add --no-cache \
    git \
    make \
    curl \
    build-base \
    openssl-dev

# Set working directory
WORKDIR /app

# Copy dependency files
COPY rebar3 /usr/local/bin/
COPY rebar.config.lock .
COPY rebar.config .
{% if module.hotci_enabled %}
COPY src_hotci ./src
{% else %}
COPY src ./src
{% endif %}
COPY include ./include
COPY config ./config

# Build application with profile-specific optimizations
{% if module.hotci_enabled %}
RUN rebar3 as hotci compile
{% else %}
RUN rebar3 compile
{% endif %}

# Stage 2: Production stage
FROM {{ base_image }}

# Create non-root user with specific UID/GID for security
RUN addgroup -g {{ app_gid }} -S {{ app_group }} && \
    adduser -S {{ app_user }} -u {{ app_uid }} -G {{ app_group }}

# Set working directory
WORKDIR /app

# Copy built artifacts from builder stage
COPY --from=builder --chown={{ app_user }}:{{ app_group }} /app/_build/prod/rel/{{ app_name }} /app
COPY --from=builder --chown={{ app_user }}:{{ app_group }} /app/config /app/config

# Create necessary directories with proper permissions
RUN mkdir -p /app/log /app/data /app/tmp && \
    chown -R {{ app_user }}:{{ app_group }} /app && \
    chmod -R 755 /app

{% if module.hotci_enabled %}
# HotCI specific setup
RUN mkdir -p /app/hotci_data && \
    chown {{ app_user }}:{{ app_group }} /app/hotci_data
{% endif %}

# Switch to non-root user
USER {{ app_user }}

# Expose application port
EXPOSE {{ app_port }}

# Health check configuration
HEALTHCHECK --interval={{ health_check_interval }} \
    --timeout={{ health_check_timeout }} \
    --start-period={{ health_check_start_period }} \
    --retries={{ health_check_retries }} \
    CMD curl -f http://localhost:{{ app_port }}{{ health_check_path }} || exit 1

# Set environment variables
ENV ERL_AFLAGS="+pc unicode +sbwt none +sbwtdcpu none +sbwtdio none"
ENV ERL_FULLSWEEP_AFTER=0

# Start the application
CMD ["/app/bin/{{ app_name }}", "foreground"]