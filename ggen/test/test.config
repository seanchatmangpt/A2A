% Test configuration for ggen system

% Erlang compiler options
{erl_opts, [debug_info, warnings_as_errors, nowarn_unused_vars]}.

% Include directories
{incl_dirs, ["src", "test"]}.

% EUnit test options
{cover_enabled, true}.
{cover_opts, [{level, details}]}.

% Dependencies
{deps, [
    {eunit, {git, "https://github.com/erlang/eunit.git", "master"}},
    {rebar3, {git, "https://github.com/rebar/rebar3.git", "master"}}
]}.

% Project structure
{sub_dirs, []}.

% Define custom test modules
{eunit_compile_opts, [{i, "test"}]}.

% Test coverage settings
{cover_enabled, true}.
{cover_export_enabled, true}.
{cover_spec, "test/cover.spec"}.

% Define test directories
{test_dirs, ["test"]}.

% Test include paths
{include, ["include", "test/include"]}.