# =============================================================================
# Craftplan — Environment Secrets (Template)
# =============================================================================
# Copy this file to .env and fill in the actual values
# Generate secrets using the commands below:
#
# For SECRET_KEY_BASE and TOKEN_SIGNING_SECRET:
# openssl rand -base64 48
#
# For CLOAK_KEY (32-byte AES key):
# openssl rand -base64 32
#
# Keep these files secure and never commit them to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Required Secrets (Generate these values!)
# -----------------------------------------------------------------------------
SECRET_KEY_BASE=your_secret_key_base_here_min_64_bytes
TOKEN_SIGNING_SECRET=your_token_signing_secret_here_min_64_bytes
CLOAK_KEY=your_cloak_key_here_32_bytes_base64

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=your_postgres_password_here

# -----------------------------------------------------------------------------
# MinIO Configuration
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
HOST=localhost
PORT=4000
AWS_S3_BUCKET=craftplan

# -----------------------------------------------------------------------------
# Monitoring Configuration
# -----------------------------------------------------------------------------
GRAFANA_PASSWORD=your_grafana_admin_password

# -----------------------------------------------------------------------------
# Email Configuration (Optional)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=
EMAIL_API_KEY=

# -----------------------------------------------------------------------------
# Scaling Configuration
# -----------------------------------------------------------------------------
CRAFTPLAN_REPLICAS=1
CRAFTPLAN_CPU_LIMIT=1.0
CRAFTPLAN_MEMORY_LIMIT=1G
CRAFTPLAN_CPU_RESERVATION=0.25
CRAFTPLAN_MEMORY_RESERVATION=256M

POSTGRES_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=2G
POSTGRES_CPU_RESERVATION=0.25
POSTGRES_MEMORY_RESERVATION=512M

MINIO_CPU_LIMIT=1.0
MINIO_MEMORY_LIMIT=1G
MINIO_CPU_RESERVATION=0.25
MINIO_MEMORY_RESERVATION=256M

REDIS_CPU_LIMIT=0.5
REDIS_MEMORY_LIMIT=512M
REDIS_CPU_RESERVATION=0.1
REDIS_MEMORY_RESERVATION=64M

NGINX_REPLICAS=1