{performance_metrics, [
    {collection_interval, 1000},
    {metrics_retention, 3600000}, % 1 hour
    {export_enabled, true},
    {metrics_memory_limit, 100000000} % 100MB
]}.

{performance_monitor, [
    {alert_check_interval, 10000},
    {dashboard_port, 9090},
    {dashboard_update_interval, 5000},
    {alert_thresholds, [
        {mcp_error_rate, 0.05, 300000}, % 5% error rate over 5 minutes
        {a2a_error_rate, 0.02, 300000},
        {api_error_rate, 0.01, 300000},
        {response_time_threshold, 500, 300000}, % 500ms avg response time
        {cpu_usage_threshold, 80, 600000}, % 80% CPU usage over 10 minutes
        {memory_usage_threshold, 80, 600000} % 80% memory usage over 10 minutes
    ]},
    {alert_notifications, [
        {console, true},
        {email, {enabled, false}},
        {webhook, {enabled, false}}
    ]}
]}.

{cache_manager, [
    {cache_config, [
        {api_cache, 5000, 300000, lru, 100000000}, % 5k items, 5min TTL, LRU, 100MB
        {mcp_cache, 10000, 60000, lfu, 200000000}, % 10k items, 1min TTL, LFU, 200MB
        {session_cache, 1000, 3600000, lru, 50000000} % 1k items, 1hour TTL, LRU, 50MB
    ]},
    {cleanup_interval, 60000}, % 1 minute
    {memory_monitoring, true}
]}.

{http_pool, [
    {max_pool_size, 50},
    {max_idle_time, 30000}, % 30 seconds
    {connection_timeout, 10000}, % 10 seconds
    {request_timeout, 30000}, % 30 seconds
    {retry_attempts, 3},
    {connection_limit_per_host, 10},
    {pool_size_per_host, 5},
    {monitoring_enabled, true}
]}.

{load_test, [
    {max_concurrent_tests, 5},
    {default_test_duration, 300000}, % 5 minutes
    {default_ramp_up, 30000}, % 30 seconds
    {default_users, 10},
    {default_rate, 10}, % 10 requests per second
    {result_retention, 86400000}, % 24 hours
    {csv_export_path, "/tmp/load_test_results"},
    {json_export_path, "/tmp/load_test_results"}
]}.

{dashboard, [
    {port, 9090},
    {websocket_max_connections, 100},
    {heartbeat_interval, 30000}, % 30 seconds
    {update_interval, 5000}, % 5 seconds
    {metrics_history_size, 1000}, % Keep last 1000 updates
    {enable_auth, false},
    {allowed_origins, ["*"]}
]}.

{performance_integration, [
    {integration_enabled, true},
    {auto_start, true},
    {monitoring_level, detailed}, % basic, detailed, comprehensive
    {optimization_enabled, true},
    {alert_integration, true},
    {log_level, info}, % debug, info, warn, error
    {log_path, "/tmp/performance_logs"}
]}.

{craftplan_mcp, [
    {cache_ttl, 30000}, % 30 seconds
    {cache_size, 10000},
    {connection_pool_size, 50},
    {max_concurrent_requests, 1000},
    {request_timeout, 30000},
    {enable_metrics, true},
    {enable_caching, true},
    {enable_compression, true}
]}.

{craftplan_a2a, [
    {max_concurrent_tasks, 50},
    {task_timeout, 300000}, % 5 minutes
    {queue_size, 1000},
    {retry_attempts, 3},
    {enable_metrics, true},
    {enable_queue_monitoring, true},
    {enable_task_prioritization, true}
]}.

{api_client, [
    {base_url, "http://localhost:4000/api"},
    {connection_timeout, 10000},
    {request_timeout, 30000},
    {max_retries, 3},
    {enable_caching, true},
    {cache_ttl, 30000},
    {connection_pool_size, 20},
    {enable_metrics, true}
]}.

{system_monitoring, [
    {cpu_sampling_interval, 5000}, % 5 seconds
    {memory_sampling_interval, 10000}, % 10 seconds
    {network_sampling_interval, 15000}, % 15 seconds
    {disk_sampling_interval, 20000}, % 20 seconds
    {process_monitoring_interval, 30000}, % 30 seconds
    {log_file_rotation, 104857600}, % 100MB
    {log_retention_days, 30}
]}.

{performance_profiling, [
    {enabled, false}, % Set to true for profiling
    {profiling_interval, 60000}, % 1 minute
    {memory_profiling, true},
    {cpu_profiling, false},
    {process_profiling, true},
    {output_path, "/tmp/performance_profiles"},
    {max_profile_files, 10}
]}.

{performance_alerts, [
    {email_notifications, [
        {enabled, false},
        {smtp_server, "localhost"},
        {smtp_port, 587},
        {username, ""},
        {password, ""},
        {recipients, []}
    ]},
    {webhook_notifications, [
        {enabled, false},
        {url, ""},
        {headers, []},
        {timeout, 30000}
    ]},
    {slack_notifications, [
        {enabled, false},
        {webhook_url, ""},
        {channel, "#alerts"},
        {username, "performance-monitor"}
    ]}
]}.

{performance_export, [
    {influxdb, [
        {enabled, false},
        {host, "localhost"},
        {port, 8086},
        {database, "craftplan_performance"},
        {retention_policy, "30d"},
        {username, ""},
        {password, ""}
    ]},
    {prometheus, [
        {enabled, false},
        {port, 9091},
        {metrics_path, "/metrics"}
    ]},
    {grafana, [
        {enabled, false},
        {dashboard_url, ""},
        {api_key, ""}
    ]}
]}.