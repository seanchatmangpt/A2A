{application, elrmcp_bridge,
 [{description, "elrmcp MCP Bridge - Connects elrmcp to Craftplan MCP server"},
  {vsn, "1.0.0"},
  {modules, [elrmcp_bridge_app,
             elrmcp_bridge_sup,
             elrmcp_mcp_bridge,
             elrmcp_mcp_client,
             elrmcp_rate_limiter,
             elrmcp_bridge_utils]},
  {registered, [elrmcp_bridge_app,
               elrmcp_bridge_sup,
               elrmcp_mcp_bridge,
               elrmcp_rate_limiter]},
  {applications, [kernel, stdlib, cowboy, jiffy, uuid]},
  {mod, {elrmcp_bridge_app, []}},
  {start_phase, {start_bridge, 0}, []},
  {env, [
    {craftplan_url, "http://localhost:8090"},
    {timeout, 30000},
    {rate_limit, 100},
    {tool_whitelist, []},
    {tool_blacklist, []},
    {enable_caching, true},
    {cache_ttl, 300000},
    {auth_token, undefined}
  ]},
  {maxT, 3600},
  {max_heap_size, 64_000_000},
  {max_processes, 1000}
 ]}.